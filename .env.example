# ============================================================
# LSEC Translator Prototype — Variables de Entorno
# ============================================================
# Copiar este archivo como .env y completar los valores
# cp .env.example .env
# ============================================================

# --- Whisper (Módulo ASR) ---
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- Persistencia local (SQLite) y modelos offline ---
LSEC_DATABASE_PATH=data/lsec_database.sqlite
WHISPER_MODEL_PATH=data/models/whisper

# --- Servidor ---
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# ============================================================
# LSEC Translator Prototype — Variables de Entorno
# ============================================================
# Copiar este archivo como .env y completar los valores
# cp .env.example .env
# ============================================================

# --- Whisper (Módulo ASR) ---
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- Persistencia local (SQLite) y modelos offline ---
LSEC_DATABASE_PATH=data/lsec_database.sqlite
WHISPER_MODEL_PATH=data/models/whisper

# --- Servidor ---
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
MAX_UPLOAD_SIZE_MB=100

# --- Activos externos (rutas absolutas o relativas a este proyecto) ---
# Vacías usan la estructura recomendada junto al proyecto.
LSEC_DICTIONARY_ROOT=
LSEC_AVATAR_DIR=
LSEC_MANUAL_CONFIG_DIR=
LSEC_VIDEOS_DIR=
LSEC_ANIMATIONS_V27_DIR=
LSEC_ANIMATIONS_V26_DIR=
LSEC_ANIMATIONS_DIR=
LSEC_UHD_DIR=
LSEC_SENAS_DIR=
